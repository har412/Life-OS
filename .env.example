# LifeOS Environment Variables Example
# Duplicate this file as '.env' and fill in your real credentials.

# ── PWA & Web Push Notification Credentials (VAPID) ────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:your-email@example.com"

# ── Primary Database Connection (Prisma & Postgres) ────────────────
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# ── Authentication Secret (Next-Auth) ──────────────────────────────
# Generate a secure random secret using: openssl rand -base64 32
AUTH_SECRET="your-next-auth-secret"

# ── Redis Connection (Caching & Rate Limiting) ─────────────────────
REDIS_URL="redis://username:password@redis-hostname:port"

# ── QStash Configuration (Cron Tasks & Reminders scheduler) ──────
QSTASH_URL="https://qstash-us-east-1.upstash.io"
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"

# ── External Application URLs & Encryption ─────────────────────────
APP_URL="http://localhost:3000"
# Generate a secure 32-byte (64 characters) hex string for AES-256 encryption of GitHub PATs:
# openssl rand -hex 32
GITHUB_ENCRYPTION_KEY="your-github-token-encryption-hex-key"

# ── Resend SMTP Mail Service Credentials ───────────────────────────
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASSWORD="your-resend-smtp-api-password"
SMTP_FROM_EMAIL="onboarding@resend.dev"
